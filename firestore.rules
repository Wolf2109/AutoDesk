rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Radionica: radni nalozi, klijenti, vozila, fotografije, rezervne kopije
    match /autodesk_users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == 'wPmjv92Ywbgs356jFCgLdCifFXx1' && uid == request.auth.uid;
    }
    // Lična vozila: zasebna celina, odvojena od radionice
    match /autodesk_private/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == 'wPmjv92Ywbgs356jFCgLdCifFXx1' && uid == request.auth.uid;
    }
  }
}
